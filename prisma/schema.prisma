generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id          String       @id @default(cuid())
  nickname    String
  avatar      String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  hostedRooms Room[]       @relation("RoomHost")
  roomPlayers RoomPlayer[]
}

model Room {
  id             String       @id @default(cuid())
  code           String       @unique
  status         String       @default("waiting")
  hostId         String
  selectedGameId String?
  host           User         @relation("RoomHost", fields: [hostId], references: [id])
  selectedGame   Game?        @relation("RoomSelectedGame", fields: [selectedGameId], references: [id])
  players        RoomPlayer[]
  matches        Match[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([hostId])
  @@index([selectedGameId])
}

model RoomPlayer {
  id          String   @id @default(cuid())
  roomId      String
  userId      String
  socketId    String?
  isHost      Boolean  @default(false)
  isConnected Boolean  @default(true)
  joinedAt    DateTime @default(now())
  room        Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([userId])
  @@index([socketId])
}

model Game {
  id          String  @id @default(cuid())
  type        String  @unique
  name        String
  description String
  isActive    Boolean @default(true)
  rooms       Room[]  @relation("RoomSelectedGame")
  matches     Match[]
}

model Match {
  id        String    @id @default(cuid())
  roomId    String
  gameId    String
  status    String    @default("pending")
  state     Json
  startedAt DateTime
  endedAt   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  room      Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  game      Game      @relation(fields: [gameId], references: [id])

  @@index([roomId])
  @@index([gameId])
}

model ImpostorWord {
  id        String   @id @default(cuid())
  category  String
  value     String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([category, value])
  @@index([category])
  @@index([isActive])
}

model GuessWhoCard {
  id         String   @id @default(cuid())
  category   String
  value      String
  difficulty String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([category, value])
  @@index([category])
  @@index([isActive])
}

model MimicaWord {
  id        String   @id @default(cuid())
  category  String
  value     String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([category, value])
  @@index([category])
  @@index([isActive])
}
