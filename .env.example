# Runtime: use a URL com pooler (host com sufixo -pooler no Neon).
DATABASE_URL="postgresql://usuario:senha@host-pooler/banco?sslmode=require"

# Migrations: mesma URL sem o -pooler. O advisory lock do prisma migrate
# precisa de sessao estavel, o que o pooler nao garante. Se ficar em branco,
# as migrations caem no DATABASE_URL acima.
DIRECT_URL="postgresql://usuario:senha@host/banco?sslmode=require"
